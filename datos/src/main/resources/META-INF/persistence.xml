<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="taller4PU" transaction-type="JTA">
        <!-- Datasource que crea configurar-datasource.cli dentro del WildFly de Datos -->
        <jta-data-source>java:jboss/datasources/Taller4DS</jta-data-source>
        <class>edu.javeriana.taller4.datos.Usuario</class>
        <class>edu.javeriana.taller4.datos.Producto</class>
        <properties>
            <!-- Las tablas las crea db/init.sql; JPA no toca el esquema -->
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
        </properties>
    </persistence-unit>
</persistence>
