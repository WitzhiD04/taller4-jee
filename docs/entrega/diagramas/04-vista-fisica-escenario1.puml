@startuml
!pragma layout smetana
title Escenario 1 - Vista física (docker compose --profile escenario1)
skinparam shadowing false
skinparam defaultFontName Arial

node "PC del usuario" as pc {
  [Navegador] as nav
}

node "Contenedor presentacion-ejb\nTomcat 10.1 (JDK 21)\npuerto 8080" as tomcat {
  artifact "presentacion.war\n(JSF Mojarra + Weld\n+ cliente EJB WildFly)" as war1
}

node "Contenedor logica\nWildFly 38" as wlog {
  artifact "logica.war" as war2
}

node "Contenedor datos\nWildFly 38" as wdat {
  artifact "datos.war\n(JPA + datasource Taller4DS)" as war3
}

database "Contenedor postgres\nPostgreSQL 16\nBD taller4" as pg

nav --> war1 : HTTP :8080
war1 --> war2 : EJB remoto\nremote+http :8080
war2 --> war3 : EJB remoto\nremote+http :8080
war3 --> pg : JDBC :5432
@enduml
