@startuml
!pragma layout smetana
title Vista de implementación - módulos Maven y paquetes Java
skinparam shadowing false
skinparam packageStyle folder
skinparam defaultFontName Arial

package "presentacion-ejb\n(presentacion.war · esc. 1)" as mpe {
  rectangle "edu.javeriana.taller4.presentacion\n--\nLoginBean\nProductosBean\nFiltroSesion\nLocalizadorLogica" as ppe
}

package "presentacion-rest\n(presentacion.war · esc. 2 y 3)" as mpr {
  rectangle "edu.javeriana.taller4.presentacion\n--\nLoginBean\nProductosBean\nFiltroSesion\nClienteServicios" as ppr
}

package "servicios\n(servicios.war · esc. 2 y 3)" as mser {
  rectangle "edu.javeriana.taller4.servicios\n--\nServiciosApp\nAutenticacionResource\nProductoResource\nProductosSoapService\nLocalizadorLogica" as pser
}

package "logica\n(logica.war)" as mlog {
  rectangle "edu.javeriana.taller4.logica\n--\nAutenticacionBean\nGestionProductosBean\nCifrado\nLocalizadorDatos" as plog
}

package "datos\n(datos.war)" as mdat {
  rectangle "edu.javeriana.taller4.datos\n--\nUsuarioDatosBean\nProductoDatosBean\nUsuario (entidad)\nProducto (entidad)\nMETA-INF/persistence.xml" as pdat
}

package "contratos\n(jar dentro de cada .war)" as mcon {
  rectangle "edu.javeriana.taller4.contratos\n--\nAutenticacionRemote, GestionProductosRemote\nUsuarioDatosRemote, ProductoDatosRemote\nUsuarioDTO, ProductoDTO, UsuarioDatos\nLoginPeticion, ErrorRespuesta\nCredencialesInvalidasException\nDatoInvalidoException" as pcon
}

ppr --> pser : llama por REST
ppe --> plog : llama por EJB remoto
pser --> plog : llama por EJB remoto
plog --> pdat : llama por EJB remoto

ppe ..> pcon : <<import>>
ppr ..> pcon : <<import>>
pser ..> pcon : <<import>>
plog ..> pcon : <<import>>
pdat ..> pcon : <<import>>
@enduml
