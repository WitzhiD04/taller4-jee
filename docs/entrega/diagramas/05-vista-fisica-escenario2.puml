@startuml
!pragma layout smetana
title Escenario 2 - Vista física (docker compose --profile escenario2)
skinparam shadowing false
skinparam defaultFontName Arial

node "PC del usuario" as pc {
  [Navegador] as nav
  [Postman] as post
}

node "Contenedor presentacion-rest\nTomcat 10.1 (JDK 21)\npuerto 8080" as tomcat {
  artifact "presentacion.war\n(JSF Mojarra + Weld\n+ cliente Jersey)" as war1
}

node "Contenedor servicios\nWildFly 38\npuerto 8081" as wser {
  artifact "servicios.war\n(JAX-RS)" as war4
}

node "Contenedor logica\nWildFly 38" as wlog {
  artifact "logica.war" as war2
}

node "Contenedor datos\nWildFly 38" as wdat {
  artifact "datos.war\n(JPA + datasource Taller4DS)" as war3
}

database "Contenedor postgres\nPostgreSQL 16\nBD taller4" as pg

nav --> war1 : HTTP :8080
post --> war4 : HTTP/JSON :8081
war1 --> war4 : HTTP/JSON
war4 --> war2 : EJB remoto\nremote+http :8080
war2 --> war3 : EJB remoto\nremote+http :8080
war3 --> pg : JDBC :5432
@enduml
